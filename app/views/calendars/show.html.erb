<main>
  <h1>カレンダー</h1>

  <%= month_calendar(events: @stool_records, attribute: :recorded_on) do |date, records| %>
    <%= link_to new_stool_record_path(recorded_on: date), class: "day-link" do %>
      <div class="day-number"><%= date.day %></div>
      <% records.each do |record| %>
        <div class="record condition-<%= record.condition %>"><%= record.condition_label %></div>
      <% end %>
    <% end %>
  <% end %>
</main>
